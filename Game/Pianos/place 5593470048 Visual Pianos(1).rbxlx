nterAttachment]]></string><BinaryString name="Tags"></BinaryString></Properties><Item class="Vector3Value" referent="30220"><Properties><Vector3 name="Value"><X>3.935688219769418e-09</X><Y>0</Y><Z>-0.0002722442150115967</Z></Vector3><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[OriginalPosition]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="Motor6D" referent="30221"><Properties><CoordinateFrame name="C0"><X>-5.960464477539063e-08</X><Y>0.8000171184539795</Y><Z>1.1920928955078125e-07</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><CoordinateFrame name="C1"><X>-0</X><Y>-0.5000001192092896</Y><Z>-0.0002722442150115967</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Ref name="Part0">30038</Ref><Ref name="Part1">30045</Ref><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[Neck]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="Vector3Value" referent="30222"><Properties><Vector3 name="Value"><X>1.1978397369384766</X><Y>1.2024002075195312</Y><Z>1.1979007720947266</Z></Vector3><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[OriginalSize]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="Dialog" referent="30223"><Properties><float name="ConversationDistance">10</float><string name="GoodbyeDialog"><![CDATA[Nevermind]]></string><string name="InitialPrompt"><![CDATA[Welcome to PV2, What questions do you have?]]></string><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties><Item class="DialogChoice" referent="30224"><Properties><string name="ResponseDialog"><![CDATA[Many Types of factors go into Using Auto, What Question do you have concerning it?]]></string><string name="UserDialog"><![CDATA[How do I use Auto?]]></string><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties><Item class="DialogChoice" referent="30225"><Properties><string name="ResponseDialog"><![CDATA[After you Purchase Auto, You can use the command ">Auto" in chat or go to the Menu at the bottom left and Select "Auto" to Open the Auto Menu!]]></string><string name="UserDialog"><![CDATA[How do I open Auto?]]></string><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="DialogChoice" referent="30226"><Properties><string name="ResponseDialog"><![CDATA[After you copy a Sheet, Paste it into the blank space and press the Arrow button to start, Use the buttons "[" , "]" Or "-", "=" to play each note.]]></string><string name="UserDialog"><![CDATA[How to I play songs on Auto?]]></string><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="DialogChoice" referent="30227"><Properties><string name="ResponseDialog"><![CDATA[After you are done playing, Press the Box to Pause the sheet and Select all of the notes by either using Ctrl+A on your keyboard or drag and select all of the notes and delete the whole sheet and input your new sheet and simply press play!]]></string><string name="UserDialog"><![CDATA[How do I input a new sheet?]]></string><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="DialogChoice" referent="30228"><Properties><string name="ResponseDialog"><![CDATA[To Report someone, On the top right of your screen Select the "Report" box to report Someone. Any Other Questions?]]></string><string name="UserDialog"><![CDATA[How do I Report someone?]]></string><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties><Item class="DialogChoice" referent="30229"><Properties><string name="ResponseDialog"><![CDATA[Autoing is not against the rules!. Unless someone is being mean about autoing or using it as threats Autoing is NOT a Reportable Offense.]]></string><string name="UserDialog"><![CDATA[Why Cant I Report someone for Autoing?]]></string><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="DialogChoice" referent="30230"><Properties><string name="ResponseDialog"><![CDATA[Oh no!, You can report a bug to the Developers by making a support ticket in the community server and explaining what happened. Anything else?]]></string><string name="UserDialog"><![CDATA[How do I Report a bug?]]></string><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties><Item class="DialogChoice" referent="30231"><Properties><string name="ResponseDialog"><![CDATA[You can find the community server Underneath the description of Piano Visualizations. Anything else?]]></string><string name="UserDialog"><![CDATA[How do I find the Community server?]]></string><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties><Item class="DialogChoice" referent="30232"><Properties><string name="ResponseDialog"><![CDATA[You can make a Ticket by Going to the #Support Channel and Selecting "Developer Support" if you have a bug or question. and "Staff Support" if you have any Concerns about reporting a user.]]></string><string name="UserDialog"><![CDATA[How do I Make a ticket?]]></string><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties></Item></Item></Item><Item class="DialogChoice" referent="30233"><Properties><string name="ResponseDialog"><![CDATA[You can use SoundEffects by selecting the button on the right side of the piano that looks like a wave to Open the SoundEffect menu!. Beware mixing too much Will Make Unpleasent sounds.]]></string><string name="UserDialog"><![CDATA[How do I use SoundEffects?]]></string><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="DialogChoice" referent="30234"><Properties><string name="ResponseDialog"><![CDATA[You can Get Piano points by either purchasing them in the shop or Playing music or Listening to other users play! Any other Questions?]]></string><string name="UserDialog"><![CDATA[How do I Get Piano Points?]]></string><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties><Item class="DialogChoice" referent="30235"><Properties><string name="ResponseDialog"><![CDATA[You cannot earn Piano points if you are AFK or playing the same notes over again!.]]></string><string name="UserDialog"><![CDATA[Why am I not Earning Points?]]></string><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="DialogChoice" referent="30236"><Properties><string name="ResponseDialog"><![CDATA[There are two Ways to Access the Points shop!, One is to Simply press the box on the bottom right to open the shop or Two is to Go to the Items Shop in the Menu at the bottom left and Press the Plus Button!.]]></string><string name="UserDialog"><![CDATA[How do I Find the Points Shop?]]></string><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties></Item></Item><Item class="DialogChoice" referent="30237"><Properties><string name="ResponseDialog"><![CDATA[You can buy Cosmetics by going into the Item Shop by opening the menu at the bottom left of the screen and Selecting "items", Anything else?.]]></string><string name="UserDialog"><![CDATA[How do I buy Cosmetics?]]></string><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties><Item class="DialogChoice" referent="30238"><Properties><string name="ResponseDialog"><![CDATA[If you have enough points to purchase an item, Hover over the green area on a Item and hold down click to buy the item, If you want to Equip it simply click the item after you purchased it!.]]></string><string name="UserDialog"><![CDATA[How do I buy and equip items?]]></string><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties></Item></Item></Item><Item class="Decal" referent="30239"><Properties><Content name="Texture"><url><![CDATA[rbxasset://textures/face.png]]></url></Content><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[face]]></string><BinaryString name="Tags"></BinaryString></Properties></Item></Item></Item></Item><Item class="ImageLabel" referent="30240"><Properties><Content name="Image"><url><![CDATA[rbxassetid://5593486058]]></url></Content><Color3 name="ImageColor3"><R>0.125490203499794</R><G>0.125490203499794</G><B>0.125490203499794</B></Color3><token name="Scal