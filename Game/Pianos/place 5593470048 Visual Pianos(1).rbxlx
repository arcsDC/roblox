Suspendisse quis metus a ipsum sollicitudin viverra. Sed vehicula euismod neque, id ornare orci fringilla vel. Fusce ornare auctor nibh, vitae vehicula lectus tincidunt ac. In dictum, risus eget lobortis aliquet, ante eros interdum ex, quis lacinia mauris sapien et augue. In fermentum ante sit amet nunc rutrum, quis finibus mi rutrum. Ut ultricies non sem quis pellentesque. Donec elementum erat in blandit suscipit. Maecenas finibus maximus ligula nec scelerisque. Maecenas convallis pulvinar tellus, quis sodales massa]]></string><Color3 name="TextColor3"><R>0.6666666865348816</R><G>0.6666666865348816</G><B>0.6666666865348816</B></Color3><float name="TextSize">20</float><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><token name="TextYAlignment">0</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><int name="BorderSizePixel">0</int><int name="LayoutOrder">2</int><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name"><![CDATA[PageText]]></string><BinaryString name="Tags"></BinaryString></Properties></Item><Item class="UIPadding" referent="21857"><Properties><UDim name="PaddingBottom"><S>0.02500000037252903</S><O>0</O></UDim><UDim name="PaddingLeft"><S>0.02500000037252903</S><O>0</O></UDim><UDim name="PaddingRight"><S>0.02500000037252903</S><O>0</O></UDim><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><BinaryString name="Tags"></BinaryString></Properties></Item></Item></Item><Item class="Frame" referent="21858"><Properties><Color3 name="BackgroundColor3"><R>0.18039216101169586</R><G>0.18039216101169586</G><B>0.18039216101169586</B></Color3><Color3 name="BorderColor3"><R>0.13333334028720856</R><G>0.13333334028720856</G><B>0.133333340287